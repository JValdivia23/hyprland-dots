# Lock AMD Radeon RX 7700 XT (Navi 32, 1002:747e) DPM level to "high" on dual mixed-refresh displays
# Prevents MCLK/FCLK/SOCCLK clock-switching vblank underflows (horizontal black lines/bands near top of screen)
ACTION=="add|change", SUBSYSTEM=="drm", KERNEL=="card[0-9]", DRIVERS=="amdgpu", ATTRS{vendor}=="0x1002", ATTRS{device}=="0x747e", ATTR{device/power_dpm_force_performance_level}="high"
