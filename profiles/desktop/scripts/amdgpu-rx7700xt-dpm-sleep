#!/usr/bin/env bash
# Re-apply AMD Radeon RX 7700 XT (1002:747e) DPM "high" level after suspend/hibernate resume
[ "${1:-}" = "post" ] || exit 0
for dev in /sys/class/drm/card[0-9]/device; do
    if [ "$(cat "$dev/vendor" 2>/dev/null)" = "0x1002" ] && \
       [ "$(cat "$dev/device" 2>/dev/null)" = "0x747e" ] && \
       [ -w "$dev/power_dpm_force_performance_level" ]; then
        echo high > "$dev/power_dpm_force_performance_level"
    fi
done
