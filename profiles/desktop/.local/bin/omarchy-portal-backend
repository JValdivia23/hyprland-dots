#!/usr/bin/env python3
import sys
import os
import urllib.parse
import subprocess
from gi.repository import GLib, Gio

# Introspection XML for the backend interface
introspection_xml = """
<node>
  <interface name="org.freedesktop.impl.portal.Wallpaper">
    <method name="SetWallpaperURI">
      <arg type="o" name="handle" direction="in"/>
      <arg type="s" name="app_id" direction="in"/>
      <arg type="s" name="parent_window" direction="in"/>
      <arg type="s" name="uri" direction="in"/>
      <arg type="a{sv}" name="options" direction="in"/>
      <arg type="u" name="response" direction="out"/>
    </method>
  </interface>
</node>
"""

class WallpaperPortalBackend:
    def __init__(self):
        self.node_info = Gio.DBusNodeInfo.new_for_xml(introspection_xml)
        self.interface_info = self.node_info.interfaces[0]

    def handle_method_call(self, connection, sender, object_path, interface_name, method_name, parameters, invocation):
        if method_name == "SetWallpaperURI":
            handle, app_id, parent_window, uri, options = parameters.unpack()
            
            # Parse URI to path
            try:
                parsed = urllib.parse.urlparse(uri)
                path = urllib.parse.unquote(parsed.path)
                if os.path.exists(path):
                    # Call setting background
                    bg_script = os.path.expanduser("~/.local/bin/omarchy-theme-bg-set")
                    subprocess.run([bg_script, path], check=True)
                    invocation.return_value(GLib.Variant('(u)', (0,))) # 0 = Success
                    return
            except Exception as e:
                sys.stderr.write(f"Error setting wallpaper: {e}\n")
            
            invocation.return_value(GLib.Variant('(u)', (1,))) # 1 = Cancelled/Failed

def on_bus_acquired(connection, name):
    backend = WallpaperPortalBackend()
    connection.register_object(
        "/org/freedesktop/portal/desktop",
        backend.interface_info,
        backend.handle_method_call,
        None,
        None
    )

def on_name_acquired(connection, name):
    pass

def on_name_lost(connection, name):
    sys.exit(1)

def main():
    Gio.bus_own_name(
        Gio.BusType.SESSION,
        "org.freedesktop.impl.portal.desktop.omarchy",
        Gio.BusNameOwnerFlags.NONE,
        on_bus_acquired,
        on_name_acquired,
        on_name_lost
    )
    
    loop = GLib.MainLoop()
    try:
        loop.run()
    except KeyboardInterrupt:
        pass

if __name__ == "__main__":
    main()
