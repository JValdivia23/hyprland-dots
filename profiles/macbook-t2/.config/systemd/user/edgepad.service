[Unit]
Description=edgepad touchpad edge gesture daemon
Documentation=https://github.com/assembledev/edgepad
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=45s
ExecStart=/bin/sh -c 'if [ -z "$$WAYLAND_DISPLAY" ]; then export WAYLAND_DISPLAY=$$(ls -1 /run/user/$$(id -u)/wayland-* 2>/dev/null | head -n1 | xargs -r basename); fi; exec %h/.local/bin/edgepad daemon --config %h/.config/edgepad/edgepad.toml'
ExecReload=kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s
StartLimitIntervalSec=30s
StartLimitBurst=10
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=graphical-session.target
