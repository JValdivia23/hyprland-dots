#!/usr/bin/env bash
# Quick Look overlay for Hyprland & Dolphin using swayimg

if pgrep -x "swayimg" > /dev/null; then
    pkill -x "swayimg"
    exit 0
fi

FILE_PATH=""

if [ -n "$1" ]; then
    FILE_PATH="$1"
    FILE_PATH=$(python3 -c "import sys, urllib.parse; p = sys.stdin.read().strip(); p = p.replace('file://', ''); print(urllib.parse.unquote(p))" <<< "$FILE_PATH")
fi

if [ -z "$FILE_PATH" ] || [ ! -f "$FILE_PATH" ]; then
    DOLPHIN_BUS=$(busctl --user list 2>/dev/null | grep -i dolphin | awk '{print $1}' | head -n1)
    if [ -n "$DOLPHIN_BUS" ]; then
        OLD_CLIP=$(wl-paste 2>/dev/null || true)
        gdbus call --session --dest "$DOLPHIN_BUS" --object-path /dolphin/Dolphin_1/actions/copy_location --method org.qtproject.Qt.QAction.trigger >/dev/null 2>&1
        sleep 0.05
        RAW_PATH=$(wl-paste 2>/dev/null | head -n1)
        if [ -n "$OLD_CLIP" ]; then
            echo -n "$OLD_CLIP" | wl-copy 2>/dev/null &
        fi
        FILE_PATH=$(python3 -c "import sys, urllib.parse; p = sys.stdin.read().strip(); p = p.replace('file://', ''); print(urllib.parse.unquote(p))" <<< "$RAW_PATH")
    fi
fi

if [ -f "$FILE_PATH" ]; then
    DIR_PATH=$(dirname "$FILE_PATH")
    swayimg -c ~/.config/swayimg/config.lua "$FILE_PATH" "$DIR_PATH" &
fi
