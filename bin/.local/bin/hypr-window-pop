#!/bin/bash

# Toggle to pop-out a tile to stay fixed/pinned on a display basis.
# Usage:
#   hypr-window-pop        -> Medium pop-out (1100x700, centered)
#   hypr-window-pop pip    -> Compact Video Picture-in-Picture (560x315, centered)

if [[ "$1" == "pip" ]]; then
  width=560
  height=315
else
  width=${1:-1100}
  height=${2:-700}
fi

active=$(hyprctl activewindow -j)
pinned=$(echo "$active" | jq ".pinned")
floating=$(echo "$active" | jq ".floating")

if [[ $pinned == "true" ]]; then
  # Window is pinned -> unpin it and unfloat back to tiled
  hyprctl dispatch 'hl.dsp.window.pin({ action = "toggle" })'
  hyprctl dispatch 'hl.dsp.window.float({ action = "toggle" })'
elif [[ $floating == "true" ]]; then
  # Already floating but not pinned -> just pin it
  hyprctl dispatch 'hl.dsp.window.pin({ action = "toggle" })'
else
  # Tiled window -> float, resize using native Lua API, center, pin
  hyprctl dispatch 'hl.dsp.window.float({ action = "toggle" })'
  hyprctl dispatch 'hl.dsp.window.resize({ x = '"$width"', y = '"$height"', exact = true })'
  hyprctl dispatch 'hl.dsp.window.center()'
  hyprctl dispatch 'hl.dsp.window.pin({ action = "toggle" })'
  hyprctl dispatch 'hl.dsp.exec_raw("alterzorder", "top")'
fi
