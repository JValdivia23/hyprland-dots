#!/bin/bash

# Get active window JSON
active=$(hyprctl activewindow -j)

# Extract class and floating status
class=$(echo "$active" | jq -r '.class')
floating=$(echo "$active" | jq -r '.floating')
class_lower=$(echo "$class" | tr '[:upper:]' '[:lower:]')

is_terminal=0
case "$class_lower" in
    alacritty|kitty|foot|wezterm|ghostty|com.mitchellh.ghostty|st|rio|xterm|gnome-terminal)
        is_terminal=1
        ;;
esac

action="$1"

case "$action" in
    line-home)
        hyprctl dispatch sendshortcut ",Home,activewindow"
        ;;
    line-end)
        hyprctl dispatch sendshortcut ",End,activewindow"
        ;;
    copy)
        if [ "$is_terminal" -eq 1 ]; then
            hyprctl dispatch sendshortcut "CTRL SHIFT,C,activewindow"
        else
            hyprctl dispatch sendshortcut "CTRL,C,activewindow"
        fi
        ;;
    cut)
        if [ "$is_terminal" -eq 1 ]; then
            hyprctl dispatch sendshortcut "CTRL SHIFT,C,activewindow"
        else
            hyprctl dispatch sendshortcut "CTRL,X,activewindow"
        fi
        ;;
    paste)
        if [ "$is_terminal" -eq 1 ]; then
            hyprctl dispatch sendshortcut "SHIFT,Insert,activewindow"
        else
            hyprctl dispatch sendshortcut "CTRL,V,activewindow"
        fi
        ;;
    undo)
        if [ "$is_terminal" -eq 0 ]; then
            hyprctl dispatch sendshortcut "CTRL,Z,activewindow"
        fi
        ;;
    redo)
        if [ "$is_terminal" -eq 0 ]; then
            hyprctl dispatch sendshortcut "CTRL SHIFT,Z,activewindow"
        fi
        ;;
    word-backspace)
        if [ "$is_terminal" -eq 1 ]; then
            hyprctl dispatch sendshortcut "ALT,BackSpace,activewindow"
        else
            hyprctl dispatch sendshortcut "CTRL,BackSpace,activewindow"
        fi
        ;;
    line-backspace)
        if [ "$is_terminal" -eq 1 ]; then
            hyprctl dispatch sendshortcut "CTRL,U,activewindow"
        else
            hyprctl dispatch sendshortcut "SHIFT,Home,activewindow"
            hyprctl dispatch sendshortcut ",BackSpace,activewindow"
        fi
        ;;
    word-left)
        if [ "$is_terminal" -eq 1 ]; then
            hyprctl dispatch sendshortcut "ALT,Left,activewindow"
        else
            hyprctl dispatch sendshortcut "CTRL,Left,activewindow"
        fi
        ;;
    word-right)
        if [ "$is_terminal" -eq 1 ]; then
            hyprctl dispatch sendshortcut "ALT,Right,activewindow"
        else
            hyprctl dispatch sendshortcut "CTRL,Right,activewindow"
        fi
        ;;
    word-select-left)
        if [ "$is_terminal" -eq 1 ]; then
            hyprctl dispatch sendshortcut "ALT SHIFT,Left,activewindow"
        else
            hyprctl dispatch sendshortcut "CTRL SHIFT,Left,activewindow"
        fi
        ;;
    word-select-right)
        if [ "$is_terminal" -eq 1 ]; then
            hyprctl dispatch sendshortcut "ALT SHIFT,Right,activewindow"
        else
            hyprctl dispatch sendshortcut "CTRL SHIFT,Right,activewindow"
        fi
        ;;
    doc-home)
        if [ "$is_terminal" -eq 1 ]; then
            hyprctl dispatch sendshortcut ",Home,activewindow"
        else
            hyprctl dispatch sendshortcut "CTRL,Home,activewindow"
        fi
        ;;
    doc-end)
        if [ "$is_terminal" -eq 1 ]; then
            hyprctl dispatch sendshortcut ",End,activewindow"
        else
            hyprctl dispatch sendshortcut "CTRL,End,activewindow"
        fi
        ;;
    select-line-left)
        if [ "$floating" = "true" ]; then
            hyprctl dispatch resizeactive "-20 0"
        else
            hyprctl dispatch sendshortcut "SHIFT,Home,activewindow"
        fi
        ;;
    select-line-right)
        if [ "$floating" = "true" ]; then
            hyprctl dispatch resizeactive "20 0"
        else
            hyprctl dispatch sendshortcut "SHIFT,End,activewindow"
        fi
        ;;
    select-doc-up)
        if [ "$floating" = "true" ]; then
            hyprctl dispatch resizeactive "0 -20"
        else
            if [ "$is_terminal" -eq 1 ]; then
                hyprctl dispatch sendshortcut "SHIFT,Home,activewindow"
            else
                hyprctl dispatch sendshortcut "CTRL SHIFT,Home,activewindow"
            fi
        fi
        ;;
    select-doc-down)
        if [ "$floating" = "true" ]; then
            hyprctl dispatch resizeactive "0 20"
        else
            if [ "$is_terminal" -eq 1 ]; then
                hyprctl dispatch sendshortcut "SHIFT,End,activewindow"
            else
                hyprctl dispatch sendshortcut "CTRL SHIFT,End,activewindow"
            fi
        fi
        ;;
esac
