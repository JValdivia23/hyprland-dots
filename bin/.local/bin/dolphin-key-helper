#!/bin/bash
action="$1"
active=$(hyprctl activewindow -j 2>/dev/null)
class=$(echo "$active" | jq -r '.class')

if [ "$class" = "org.kde.dolphin" ]; then
    DOLPHIN_BUS=$(busctl --user list 2>/dev/null | grep -i dolphin | awk '{print $1}' | head -n1)
    case "$action" in
        quicklook)
            ~/.local/bin/hypr-quicklook
            ;;
        selection)
            if [ -n "$DOLPHIN_BUS" ]; then
                gdbus call --session --dest "$DOLPHIN_BUS" --object-path /dolphin/Dolphin_1/actions/toggle_selection_mode --method org.qtproject.Qt.QAction.trigger >/dev/null 2>&1
            fi
            ;;
        contextmenu)
            hyprctl dispatch 'hl.dsp.send_shortcut({ mods = "SHIFT", key = "F10", window = "activewindow" })'
            ;;
    esac
fi
