#!/bin/bash
action=$1
if [[ "$action" == "up" ]]; then
  brightnessctl -d asus::kbd_backlight set +1
else
  brightnessctl -d asus::kbd_backlight set 1-
fi

val=$(brightnessctl -d asus::kbd_backlight get)

case $val in
  0) label="Off" ;;
  1) label="Low" ;;
  2) label="Medium" ;;
  3) label="High" ;;
  *) label="$val/3" ;;
esac

# Send standard desktop notification and Noctalia internal notification
notify-send -h string:x-canonical-private-synchronous:kbd-backlight -t 1500 "Keyboard Backlight" "Level: $label"
noctalia msg notification-show "Keyboard Backlight -- Level: $label"
