#!/bin/bash
action=$1
device="apple::kbd_backlight"
if [ ! -d "/sys/class/leds/$device" ]; then
  # fallback to asus or any kbd backlight
  device=$(ls /sys/class/leds/ 2>/dev/null | grep -E 'kbd_backlight|kbd' | head -n 1)
fi

if [[ -z "$device" ]]; then
  exit 0
fi

if [[ "$action" == "up" ]]; then
  brightnessctl -d "$device" set +10%
else
  brightnessctl -d "$device" set 10%-
fi

val=$(brightnessctl -d "$device" get)
max=$(brightnessctl -d "$device" max)
percent=$(( val * 100 / max ))

if [[ $percent -eq 0 ]]; then
  label="Off"
elif [[ $percent -le 25 ]]; then
  label="Low ($percent%)"
elif [[ $percent -le 75 ]]; then
  label="Medium ($percent%)"
else
  label="High ($percent%)"
fi

# Send standard desktop notification
notify-send -h string:x-canonical-private-synchronous:kbd-backlight -t 1500 "Keyboard Backlight" "Level: $label" 2>/dev/null || true
