#!/usr/bin/env python3
import subprocess

def main():
    try:
        raw = subprocess.check_output(['fastfetch', '--logo', 'none'], stderr=subprocess.DEVNULL).decode('utf-8', errors='ignore')
    except Exception:
        return

    data = {}
    for line in raw.split('\n'):
        if ':' in line:
            k, v = line.split(':', 1)
            data[k.strip()] = v.strip()

    C_GREEN = "\033[1;32m"
    C_CYAN = "\033[1;36m"
    C_RESET = "\033[0m"
    C_KEY = "\033[1;36m"
    C_VAL = "\033[0m"

    colored_logo = [
        f"{C_GREEN}     ...........{C_RESET}",
        f"{C_GREEN}    /{C_CYAN},,,,.....{C_GREEN}/{C_RESET} ",
        f"{C_GREEN}   /{C_CYAN},,,..,,..{C_GREEN}/   ()",
        f"{C_GREEN}  /{C_CYAN},,,,..{C_GREEN}/      ",
        f"{C_GREEN} /{C_CYAN},,,...{C_GREEN}/     /{C_CYAN}'\\{C_RESET}",
        f"{C_GREEN}/{C_CYAN},.....{C_GREEN}/      \\{C_CYAN},/{C_RESET}",
        f"{C_GREEN}\\{C_CYAN},,,,,,{C_GREEN}\\\\             _{C_RESET}",
        f"{C_GREEN} \\{C_CYAN},,....{C_GREEN}\\\\           / \\",
        f"{C_GREEN}  \\{C_CYAN}...,..{C_GREEN}\\\\          \\_/",
        f"{C_GREEN}   \\{C_CYAN}..,,,,,,,,,,,,{C_GREEN}/{C_RESET}",
        f"{C_GREEN}    \\{C_CYAN},........,,{C_GREEN}/{C_RESET}"
    ]

    color_palette_1 = "\033[40m   \033[41m   \033[42m   \033[43m   \033[44m   \033[45m   \033[46m   \033[47m   \033[0m"
    color_palette_2 = "\033[100m   \033[101m   \033[102m   \033[103m   \033[104m   \033[105m   \033[106m   \033[107m   \033[0m"

    def clean_val(key, val):
        if key == 'Host':
            return val.replace('GA401IV_GA401IV (1.0)', '').strip() or val
        if 'GPU' in key:
            return val.replace('NVIDIA GeForce ', '').replace('AMD Radeon ', '').replace(' Series / Radeon Vega Mobile Series', '')
        if 'Display' in key:
            return val.split(' in ')[0]
        return val

    user_host = "user@cachy-asus"

    top_left_data = [
        ("OS", data.get("OS", "")),
        ("Kernel", data.get("Kernel", "")),
        ("Host", clean_val("Host", data.get("Host", ""))),
        ("WM", data.get("WM", "")),
        ("CPU", clean_val("CPU", data.get("CPU", ""))),
        ("GPU 1", clean_val("GPU 1", data.get("GPU 1", ""))),
        ("GPU 2", clean_val("GPU 2", data.get("GPU 2", ""))),
        ("Shell", "fish"),
        ("Terminal", "kitty"),
        ("Packages", data.get("Packages", "")),
        ("Display", clean_val("Display", data.get("Display (AUOE68C)", data.get("Display", ""))))
    ]

    bottom_specs = [
        (("RAM", data.get('Memory', '')), ("Disk", data.get('Disk (/)', ''))),
        (("Swap", data.get('Swap', '')), ("Theme", data.get('Theme', ''))),
        (("Icons", data.get('Icons', '')), ("Cursor", data.get('Cursor', ''))),
        (("Uptime", data.get('Uptime', '')), ("Battery", data.get('Battery (ASUS Battery)', data.get('Battery', '')))),
        (("Local IP", data.get('Local IP (wlan0)', '')), ("Locale", data.get('Locale', '')))
    ]

    print(f"{C_GREEN}user{C_RESET}@{C_GREEN}cachy-asus{C_RESET}")
    print(f"{C_CYAN}" + "─" * 74 + f"{C_RESET}")

    max_top_width = max(len(f"{k}: {v}") for k, v in top_left_data)
    pad_target = max(max_top_width + 2, 43)

    for i in range(11):
        k, v = top_left_data[i]
        left_plain = f"{k}: {v}"
        left_str = f"{C_KEY}{k}{C_RESET}: {C_VAL}{v}{C_RESET}"
        logo = colored_logo[i]
        pad_len = max(0, pad_target - len(left_plain))
        print(f"{left_str}{' ' * pad_len}{logo}")

    for (k1, v1), (k2, v2) in bottom_specs:
        p1 = f"{k1}: {v1}"
        str1 = f"{C_KEY}{k1}{C_RESET}: {C_VAL}{v1}{C_RESET}"
        pad1 = max(0, 36 - len(p1))
        str2 = f"{C_KEY}{k2}{C_RESET}: {C_VAL}{v2}{C_RESET}"
        print(f"{str1}{' ' * pad1} \033[90m│\033[0m {str2}")

    print(f"\n     {color_palette_1}   {color_palette_2}")

if __name__ == "__main__":
    main()
