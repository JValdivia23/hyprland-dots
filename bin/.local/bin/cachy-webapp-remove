#!/bin/bash
# Remove Web App desktop launcher and icon

if [ "$#" -ge 1 ]; then
  APP_NAME="$1"
else
  read -p "App Name to remove: " APP_NAME
fi

if [[ -z "$APP_NAME" ]]; then
  echo "Error: Must specify App Name to remove."
  exit 1
fi

DESKTOP_FILE="$HOME/.local/share/applications/$APP_NAME.desktop"
ICON_PATH="$HOME/.local/share/applications/icons/$APP_NAME.png"

rm -f "$DESKTOP_FILE"
rm -f "$ICON_PATH"
update-desktop-database "$HOME/.local/share/applications" 2>/dev/null || true

echo "Successfully removed Web App: $APP_NAME"
