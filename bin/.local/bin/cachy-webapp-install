#!/bin/bash
# Omarchy-compatible Web App Installer using Brave Origin

if [ "$#" -lt 2 ]; then
  if command -v gum >/dev/null 2>&1; then
    APP_NAME=$(gum input --prompt "Name> " --placeholder "My favorite web app")
    APP_URL=$(gum input --prompt "URL> " --placeholder "https://example.com")
    ICON_URL=$(gum input --prompt "Icon URL (optional)> " --placeholder "https://dashboardicons.com/...")
  else
    read -p "App Name: " APP_NAME
    read -p "App URL: " APP_URL
    read -p "Icon URL (optional): " ICON_URL
  fi
else
  APP_NAME="$1"
  APP_URL="$2"
  ICON_URL="$3"
fi

if [[ -z "$APP_NAME" || -z "$APP_URL" ]]; then
  echo "Error: You must provide app name and app URL!"
  exit 1
fi

ICON_DIR="$HOME/.local/share/applications/icons"
DESKTOP_FILE="$HOME/.local/share/applications/$APP_NAME.desktop"
ICON_PATH="$ICON_DIR/$APP_NAME.png"

mkdir -p "$ICON_DIR"

if [[ -n "$ICON_URL" ]]; then
  curl -sL -o "$ICON_PATH" "$ICON_URL" || echo "Warning: Could not download icon from $ICON_URL"
elif [[ ! -f "$ICON_PATH" ]]; then
  DOMAIN=$(echo "$APP_URL" | awk -F/ '{print $3}')
  curl -sL -o "$ICON_PATH" "https://www.google.com/s2/favicons?domain=${DOMAIN}&sz=128" || true
fi

cat >"$DESKTOP_FILE" <<EOF
[Desktop Entry]
Version=1.0
Name=$APP_NAME
Comment=$APP_NAME Web App
Exec=brave-origin --new-window --ozone-platform=wayland --app="$APP_URL" --name="$APP_NAME" --class="$APP_NAME"
Terminal=false
Type=Application
Icon=$ICON_PATH
StartupNotify=true
EOF

chmod +x "$DESKTOP_FILE"
update-desktop-database "$HOME/.local/share/applications" 2>/dev/null || true

echo "Successfully installed Web App: $APP_NAME"
