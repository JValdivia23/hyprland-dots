#!/usr/bin/env python3
"""
hypr-capture-menu: Interactive capture menu for Hyprland (SUPER + CTRL + C)
"""

import sys
import os
import subprocess
import shutil

OPTIONS = [
    ("📸  Smart Screenshot (Window / Region / Desktop)", ["hypr-screenshot", "smart"]),
    ("🪟  Active Window Screenshot",                         ["hypr-screenshot", "active"]),
    ("🖥️   Fullscreen Screenshot",                          ["hypr-screenshot", "fullscreen"]),
    ("📝  OCR Text Extraction",                             ["hypr-ocr"]),
    ("🎨  Color Picker (hyprpicker)",                       ["hyprpicker", "-a"]),
    ("⏺️   Screen Recording (Toggle Start/Stop)",            ["hypr-record"]),
]

def main():
    menu_lines = [opt[0] for opt in OPTIONS]
    header = "  📸 Screen Capture & Tools (ESC to exit)"

    fzf_cmd = [
        "fzf",
        "--ansi",
        f"--header={header}",
        "--prompt=🎯 Select action > ",
        "--reverse",
        "--border=rounded",
        "--info=inline",
        "--no-preview",
        "--color=header:italic:bold:cyan,pointer:bright-yellow",
    ]

    p = subprocess.Popen(fzf_cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
    out, _ = p.communicate(input="\n".join(menu_lines) + "\n")
    if p.returncode != 0 or not out.strip():
        sys.exit(0)

    selected = out.strip()
    for label, cmd in OPTIONS:
        if label == selected:
            # Fork/exec cmd detached and close menu immediately
            subprocess.Popen(cmd, start_new_session=True)
            break

if __name__ == "__main__":
    main()
