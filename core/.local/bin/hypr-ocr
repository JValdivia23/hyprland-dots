#!/usr/bin/env python3
"""
hypr-ocr: Region OCR text extraction tool for Hyprland.
Captures selected region or clicked window, runs tesseract OCR,
copies text to clipboard via wl-copy, and notifies the user.
"""

import sys
import os
import json
import subprocess
import shutil

def get_smart_boxes():
    boxes = []
    try:
        monitors = json.loads(subprocess.check_output(["hyprctl", "monitors", "-j"]))
        clients = json.loads(subprocess.check_output(["hyprctl", "clients", "-j"]))
        active_ws = {m["activeWorkspace"]["id"] for m in monitors}
        for c in clients:
            if c.get("mapped") and not c.get("hidden") and c.get("workspace", {}).get("id") in active_ws:
                x, y = c["at"]
                w, h = c["size"]
                boxes.append(f"{x},{y} {w}x{h}")
        for m in monitors:
            x, y = m["x"], m["y"]
            w, h = int(m["width"] / m["scale"]), int(m["height"] / m["scale"])
            boxes.append(f"{x},{y} {w}x{h}")
    except Exception:
        pass
    return "\n".join(boxes)

def main():
    boxes = get_smart_boxes()
    slurp_cmd = ["slurp", "-d", "-b", "00000060", "-c", "a6e3a1ff", "-s", "a6e3a122", "-B", "00000040"]
    p = subprocess.Popen(slurp_cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
    out, _ = p.communicate(input=boxes)
    if p.returncode != 0 or not out.strip():
        sys.exit(0)
    geom = out.strip()

    grim_proc = subprocess.run(["grim", "-g", geom, "-"], capture_output=True)
    if grim_proc.returncode != 0 or not grim_proc.stdout:
        sys.exit(1)

    tess_proc = subprocess.run(
        ["tesseract", "stdin", "stdout", "-l", "eng"],
        input=grim_proc.stdout,
        capture_output=True
    )
    text = tess_proc.stdout.decode("utf-8", errors="replace").strip()

    if text:
        subprocess.run(["wl-copy"], input=text.encode("utf-8"), check=True)
        preview = text if len(text) <= 120 else text[:117] + "..."
        subprocess.run([
            "notify-send",
            "-a", "OCR Extraction",
            "-i", "edit-copy",
            "Text Copied to Clipboard",
            preview
        ])
    else:
        subprocess.run([
            "notify-send",
            "-a", "OCR Extraction",
            "-i", "dialog-warning",
            "OCR Extraction",
            "No text recognized in selected area."
        ])

if __name__ == "__main__":
    main()
