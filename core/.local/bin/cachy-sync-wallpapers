#!/usr/bin/env bash
# cachy-sync-wallpapers — Download or synchronize full wallpaper collection from GitHub fork
set -euo pipefail

WALLPAPERS_DIR="$HOME/Pictures/Wallpapers"
mkdir -p "$WALLPAPERS_DIR"

# Ensure ~/Wallpapers convenience symlink exists
if [ ! -e "$HOME/Wallpapers" ] && [ ! -L "$HOME/Wallpapers" ]; then
    ln -sfn "$WALLPAPERS_DIR" "$HOME/Wallpapers" 2>/dev/null || true
fi

WALLS_REPO="${WALLS_REPO:-https://github.com/JValdivia23/walls.git}"
FALLBACK_REPO="https://github.com/dharmx/walls.git"
TARGET_DIR="$WALLPAPERS_DIR/dharmx-walls"

echo "======================================================="
echo "       🖼️  CachyOS Wallpaper Collection Sync          "
echo "======================================================="
echo "Target directory: $TARGET_DIR"

if [ -d "$TARGET_DIR/.git" ]; then
    echo "--> Existing git repository detected. Fetching latest updates..."
    git -C "$TARGET_DIR" pull --depth 1 || true
elif [ -d "$TARGET_DIR" ] && [ "${1:-}" != "--force" ]; then
    echo "--> Wallpaper directory already exists ($TARGET_DIR)."
    echo "    To re-clone from GitHub, run with: cachy-sync-wallpapers --force"
else
    if [ "${1:-}" == "--force" ] && [ -d "$TARGET_DIR" ]; then
        echo "--> Removing existing directory due to --force..."
        rm -rf "$TARGET_DIR"
    fi

    echo "--> Cloning wallpaper collection from $WALLS_REPO (shallow depth 1)..."
    if ! git clone --depth 1 "$WALLS_REPO" "$TARGET_DIR" 2>/dev/null; then
        echo "    Notice: $WALLS_REPO was unreachable. Falling back to upstream $FALLBACK_REPO..."
        git clone --depth 1 "$FALLBACK_REPO" "$TARGET_DIR"
    fi
fi

COUNT=$(find "$WALLPAPERS_DIR" -type f \( -name '*.jpg' -o -name '*.png' -o -name '*.webp' \) 2>/dev/null | wc -l)
echo "-------------------------------------------------------"
echo "✅ Synchronization complete! Total wallpapers available: $COUNT"

# Locate C++ pre-cacher source code
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CPP_SRC=""
for candidate in \
    "$SCRIPT_DIR/noctalia-precache-wallpapers.cpp" \
    "$HOME/dotfiles/core/.local/bin/noctalia-precache-wallpapers.cpp" \
    "$HOME/.local/bin/noctalia-precache-wallpapers.cpp"; do
    if [ -f "$candidate" ]; then
        CPP_SRC="$candidate"
        break
    fi
done

if ! command -v noctalia-precache-wallpapers >/dev/null 2>&1 && [ -n "$CPP_SRC" ]; then
    echo "--> Compiling noctalia-precache-wallpapers..."
    mkdir -p "$HOME/.local/bin"
    g++ -O3 -std=c++20 "$CPP_SRC" -o "$HOME/.local/bin/noctalia-precache-wallpapers" 2>/dev/null || true
fi

if command -v noctalia-precache-wallpapers >/dev/null 2>&1; then
    echo "--> Pre-caching Noctalia wallpaper thumbnails..."
    noctalia-precache-wallpapers "$WALLPAPERS_DIR" || true
fi

# Ensure Noctalia wallpaper panel state defaults to shuffle & flat view
STATE_FILE="$HOME/.local/state/noctalia/state.toml"
if [ ! -f "$STATE_FILE" ]; then
    mkdir -p "$(dirname "$STATE_FILE")"
    cat > "$STATE_FILE" << 'STATE_EOF'
[wallpaper_panel]
flatten = true
sort = "random"
STATE_EOF
elif ! grep -q "\[wallpaper_panel\]" "$STATE_FILE"; then
    cat >> "$STATE_FILE" << 'STATE_EOF'

[wallpaper_panel]
flatten = true
sort = "random"
STATE_EOF
fi

echo "   Select any wallpaper via Noctalia (Alt+Space or Super+Shift+W)."
echo "======================================================="
