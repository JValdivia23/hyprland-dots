#!/usr/bin/env python3
import subprocess

def main():
    try:
        raw = subprocess.check_output(['fastfetch', '--logo', 'none'], stderr=subprocess.DEVNULL).decode('utf-8', errors='ignore')
    except Exception:
        return

    data = {}
    for line in raw.split('\n'):
        if ':' in line:
            k, v = line.split(':', 1)
            data[k.strip()] = v.strip()

    C_GREEN = "\033[1;32m"
    C_CYAN = "\033[1;36m"
    C_RESET = "\033[0m"
    C_KEY = "\033[1;36m"
    C_VAL = "\033[0m"

    colored_logo = [
        f"{C_GREEN}     ...........{C_RESET}",
        f"{C_GREEN}    /{C_CYAN},,,,.....{C_GREEN}/{C_RESET} ",
        f"{C_GREEN}   /{C_CYAN},,,..,,..{C_GREEN}/   ()",
        f"{C_GREEN}  /{C_CYAN},,,,..{C_GREEN}/      ",
        f"{C_GREEN} /{C_CYAN},,,...{C_GREEN}/     /{C_CYAN}'\\{C_RESET}",
        f"{C_GREEN}/{C_CYAN},.....{C_GREEN}/      \\{C_CYAN},/{C_RESET}",
        f"{C_GREEN}\\{C_CYAN},,,,,,{C_GREEN}\\\\             _{C_RESET}",
        f"{C_GREEN} \\{C_CYAN},,....{C_GREEN}\\\\           / \\",
        f"{C_GREEN}  \\{C_CYAN}...,..{C_GREEN}\\\\          \\_/",
        f"{C_GREEN}   \\{C_CYAN}..,,,,,,,,,,,,{C_GREEN}/{C_RESET}",
        f"{C_GREEN}    \\{C_CYAN},........,,{C_GREEN}/{C_RESET}"
    ]

    color_palette_1 = "\033[40m   \033[41m   \033[42m   \033[43m   \033[44m   \033[45m   \033[46m   \033[47m   \033[0m"
    color_palette_2 = "\033[100m   \033[101m   \033[102m   \033[103m   \033[104m   \033[105m   \033[106m   \033[107m   \033[0m"

    def get_match(prefix):
        for k, v in data.items():
            if k.startswith(prefix):
                return v
        return ""

    def clean_val(key, val):
        if key == 'Host':
            return val.replace('GA401IV_GA401IV (1.0)', '').strip() or val
        if 'GPU' in key:
            v = val.replace(" [Discrete]", "").replace(" [Integrated]", "").strip()
            if "Pro Series" in v:
                v = v.replace("Pro Series", "Pro 560X")
            return f"{v} (dGPU)" if "dGPU" not in v and "iGPU" not in v else v
        if 'Display' in key:
            return val.replace(' in 15",', '').replace(' [Built-in]', '').strip()
        if 'CPU' in key:
            return val.replace('(R)', '').replace('(TM)', '').strip()
        if 'Battery' in key:
            return val.replace(' hours,', 'h').replace(' hour,', 'h').replace(' mins remaining', 'm').replace(' min remaining', 'm').replace(' remaining', '')
        return val

    import getpass, socket
    current_user = getpass.getuser()
    current_host = socket.gethostname()

    top_left_data = [
        ("OS", data.get("OS", "")),
        ("Kernel", data.get("Kernel", "")),
        ("Host", clean_val("Host", data.get("Host", ""))),
        ("WM", data.get("WM", "")),
        ("CPU", clean_val("CPU", data.get("CPU", ""))),
        ("GPU", clean_val("GPU", get_match("GPU"))),
        ("Display", clean_val("Display", get_match("Display"))),
        ("Shell", "fish"),
        ("Terminal", "kitty"),
        ("Packages", data.get("Packages", "")),
        ("Uptime", data.get("Uptime", ""))
    ]

    bottom_specs = [
        (("RAM", data.get('Memory', '')), ("Disk", get_match('Disk'))),
        (("Swap", data.get('Swap', '')), ("Theme", data.get('Theme', ''))),
        (("Icons", data.get('Icons', '')), ("Cursor", data.get('Cursor', ''))),
        (("Battery", clean_val("Battery", get_match('Battery'))), ("Local IP", get_match('Local IP'))),
        (("Locale", data.get('Locale', '')), ("Audio", "Apple Audio (aaudio)"))
    ]

    print(f"{C_GREEN}{current_user}{C_RESET}@{C_GREEN}{current_host}{C_RESET}")
    print(f"{C_CYAN}" + "─" * 74 + f"{C_RESET}")

    max_top_width = max(len(f"{k}: {v}") for k, v in top_left_data)
    pad_target = max(max_top_width + 2, 45)

    for i in range(11):
        k, v = top_left_data[i]
        left_plain = f"{k}: {v}"
        left_str = f"{C_KEY}{k}{C_RESET}: {C_VAL}{v}{C_RESET}"
        logo = colored_logo[i]
        pad_len = max(0, pad_target - len(left_plain))
        spaces = " " * pad_len
        print(f"{left_str}{spaces}{logo}")

    for (k1, v1), (k2, v2) in bottom_specs:
        p1 = f"{k1}: {v1}"
        str1 = f"{C_KEY}{k1}{C_RESET}: {C_VAL}{v1}{C_RESET}"
        pad1 = max(0, 36 - len(p1))
        spaces1 = " " * pad1
        str2 = f"{C_KEY}{k2}{C_RESET}: {C_VAL}{v2}{C_RESET}"
        print(f"{str1}{spaces1} \033[90m│\033[0m {str2}")

    print(f"\n     {color_palette_1}   {color_palette_2}")

if __name__ == "__main__":
    main()
