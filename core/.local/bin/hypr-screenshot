#!/usr/bin/env python3
"""
hypr-screenshot: Smart screenshot tool for Hyprland.
Modes:
  smart (default): Snap to window on click, background on click, or drag region
  active: Snap to currently focused window
  fullscreen: Capture entire focused monitor
"""

import sys
import os
import json
import subprocess
import shutil

def get_smart_boxes():
    boxes = []
    try:
        monitors = json.loads(subprocess.check_output(["hyprctl", "monitors", "-j"]))
        clients = json.loads(subprocess.check_output(["hyprctl", "clients", "-j"]))
        active_ws = {m["activeWorkspace"]["id"] for m in monitors}
        for c in clients:
            if c.get("mapped") and not c.get("hidden") and c.get("workspace", {}).get("id") in active_ws:
                x, y = c["at"]
                w, h = c["size"]
                boxes.append(f"{x},{y} {w}x{h}")
        for m in monitors:
            x, y = m["x"], m["y"]
            w, h = int(m["width"] / m["scale"]), int(m["height"] / m["scale"])
            boxes.append(f"{x},{y} {w}x{h}")
    except Exception:
        pass
    return "\n".join(boxes)

def get_active_box():
    try:
        w = json.loads(subprocess.check_output(["hyprctl", "activewindow", "-j"]))
        if "at" in w and "size" in w:
            x, y = w["at"]
            w_w, w_h = w["size"]
            return f"{x},{y} {w_w}x{w_h}"
    except Exception:
        pass
    return None

def main():
    mode = sys.argv[1] if len(sys.argv) > 1 else "smart"
    
    geom = None
    if mode == "smart":
        boxes = get_smart_boxes()
        slurp_cmd = ["slurp", "-d", "-b", "00000060", "-c", "89b4faff", "-s", "89b4fa22", "-B", "00000040"]
        p = subprocess.Popen(slurp_cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
        out, _ = p.communicate(input=boxes)
        if p.returncode != 0 or not out.strip():
            sys.exit(0)
        geom = out.strip()
    elif mode == "active":
        geom = get_active_box()
        if not geom:
            subprocess.run(["notify-send", "-a", "Screenshot", "No active window found."])
            sys.exit(1)
    elif mode == "fullscreen":
        geom = None
    else:
        geom = mode

    grim_cmd = ["grim"]
    if geom:
        grim_cmd.extend(["-g", geom])
    grim_cmd.append("-")

    save_dir = os.path.expanduser("~/Pictures/Screenshots")
    os.makedirs(save_dir, exist_ok=True)
    out_pattern = os.path.join(save_dir, "%Y-%m-%d_%H-%M-%S.png")

    satty_cmd = ["satty", "-f", "-", "--output-filename", out_pattern]

    p_grim = subprocess.Popen(grim_cmd, stdout=subprocess.PIPE)
    subprocess.run(satty_cmd, stdin=p_grim.stdout)
    p_grim.stdout.close()
    p_grim.wait()

if __name__ == "__main__":
    main()
