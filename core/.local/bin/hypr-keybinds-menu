#!/usr/bin/env python3
"""
hypr-keybinds-menu: Live IPC Keybinding Cheatsheet & Launcher for Hyprland
Queries the compositor runtime table via `hyprctl binds -j`, decodes modifiers,
launches an interactive fzf search menu, and executes the selected keybinding
on Enter.
"""

import json
import os
import subprocess
import sys
import shutil
import time

def get_hyprland_signature():
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    if sig:
        return sig
    hypr_dir = f"/run/user/{os.getuid()}/hypr"
    if os.path.isdir(hypr_dir):
        try:
            entries = sorted(os.listdir(hypr_dir))
            if entries:
                os.environ["HYPRLAND_INSTANCE_SIGNATURE"] = entries[0]
                return entries[0]
        except Exception:
            pass
    return None

def get_binds():
    get_hyprland_signature()
    try:
        res = subprocess.run(
            ["hyprctl", "binds", "-j"],
            capture_output=True,
            text=True,
            check=True
        )
        return json.loads(res.stdout)
    except Exception as e:
        print(f"Error querying hyprctl: {e}", file=sys.stderr)
        return []

MODS = [
    (64, "SUPER"),
    (8, "ALT"),
    (4, "CTRL"),
    (1, "SHIFT"),
]

def format_mods(mask):
    parts = []
    for val, name in MODS:
        if (mask & val) == val:
            parts.append(name)
            mask -= val
    return " + ".join(parts)

def trigger_bind_detached(dispatcher, arg):
    """
    Forks a detached background helper so this terminal (class 'Keybindings')
    can exit and unmap first, allowing Hyprland to restore focus to the
    previously active window before dispatching the selected keybinding.
    """
    helper_code = """
import json, subprocess, sys, time

dispatcher, arg = sys.argv[1], sys.argv[2]

for _ in range(40):
    try:
        res = subprocess.run(["hyprctl", "activewindow", "-j"], capture_output=True, text=True)
        if res.returncode == 0 and res.stdout.strip():
            win = json.loads(res.stdout)
            if win.get("class") != "Keybindings" and win.get("initialClass") != "Keybindings":
                break
        else:
            break
    except Exception:
        break
    time.sleep(0.025)

time.sleep(0.03)

if dispatcher == "__lua" and arg.isdigit():
    lua_expr = f"local fn = debug.getregistry()[{int(arg)}]; if type(fn) == 'function' then fn() end"
    subprocess.run(["hyprctl", "eval", lua_expr], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
elif dispatcher:
    cmd = ["hyprctl", "dispatch", dispatcher]
    if arg:
        cmd.append(arg)
    subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
"""
    subprocess.Popen(
        [sys.executable, "-c", helper_code, str(dispatcher), str(arg)],
        start_new_session=True,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )

def main():
    binds = get_binds()
    if not binds:
        print("No active keybindings found or Hyprland is not running.")
        sys.exit(1)

    lines = []
    bind_map = {}
    seen = set()

    for b in binds:
        desc = b.get("description", "").strip()
        if not desc:
            continue

        mods = format_mods(b.get("modmask", 0))
        key = b.get("key", "")
        if b.get("mouse", False) and not key.startswith("mouse"):
            key = f"mouse:{key}"

        combo = f"{mods} + {key}" if mods else key
        submap = b.get("submap", "").strip()
        if submap:
            combo = f"[{submap}] {combo}"

        dedup_key = (combo, desc)
        if dedup_key in seen:
            continue
        seen.add(dedup_key)

        line = f"{combo:<32} │  {desc}"
        lines.append(line)
        bind_map[line] = (b.get("dispatcher", ""), str(b.get("arg", "")))

    if not lines:
        print("No keybindings with descriptions registered in Hyprland.")
        sys.exit(1)

    lines.sort()

    header = f"  ⌨️  Hyprland Live Keybindings ({len(lines)} registered) — ENTER to run · ESC to exit"

    if shutil.which("fzf"):
        fzf_cmd = [
            "fzf",
            "--ansi",
            f"--header={header}",
            "--prompt=🔍 Search binds > ",
            "--reverse",
            "--border=rounded",
            "--info=inline",
            "--no-preview",
            "--color=header:italic:bold:yellow,pointer:bright-cyan",
        ]
        p = subprocess.Popen(fzf_cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
        out, _ = p.communicate(input="\n".join(lines) + "\n")
        if p.returncode != 0 or not out:
            sys.exit(0)

        selected = out.rstrip("\r\n")
        target = bind_map.get(selected)
        if target:
            trigger_bind_detached(target[0], target[1])
    else:
        print(header)
        print("-" * 70)
        for line in lines:
            print(line)

if __name__ == "__main__":
    main()
