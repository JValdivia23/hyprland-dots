#!/usr/bin/env python3
"""
hypr-keybinds-menu: Live IPC Keybinding Cheatsheet for Hyprland
Queries the compositor runtime table via `hyprctl binds -j`, decodes modifiers,
and launches an interactive fzf search menu.
"""

import json
import os
import subprocess
import sys
import shutil

def get_hyprland_signature():
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    if sig:
        return sig
    hypr_dir = f"/run/user/{os.getuid()}/hypr"
    if os.path.isdir(hypr_dir):
        try:
            entries = sorted(os.listdir(hypr_dir))
            if entries:
                os.environ["HYPRLAND_INSTANCE_SIGNATURE"] = entries[0]
                return entries[0]
        except Exception:
            pass
    return None

def get_binds():
    get_hyprland_signature()
    try:
        res = subprocess.run(
            ["hyprctl", "binds", "-j"],
            capture_output=True,
            text=True,
            check=True
        )
        return json.loads(res.stdout)
    except Exception as e:
        print(f"Error querying hyprctl: {e}", file=sys.stderr)
        return []

MODS = [
    (64, "SUPER"),
    (8, "ALT"),
    (4, "CTRL"),
    (1, "SHIFT"),
]

def format_mods(mask):
    parts = []
    for val, name in MODS:
        if (mask & val) == val:
            parts.append(name)
            mask -= val
    return " + ".join(parts)

def main():
    binds = get_binds()
    if not binds:
        print("No active keybindings found or Hyprland is not running.")
        sys.exit(1)

    lines = []
    seen = set()

    for b in binds:
        desc = b.get("description", "").strip()
        if not desc:
            continue

        mods = format_mods(b.get("modmask", 0))
        key = b.get("key", "")
        if b.get("mouse", False) and not key.startswith("mouse"):
            key = f"mouse:{key}"

        combo = f"{mods} + {key}" if mods else key
        dedup_key = (combo, desc)
        if dedup_key in seen:
            continue
        seen.add(dedup_key)

        lines.append(f"{combo:<32} │  {desc}")

    if not lines:
        print("No keybindings with descriptions registered in Hyprland.")
        sys.exit(1)

    lines.sort()

    header = f"  ⌨️  Hyprland Live Keybindings ({len(lines)} registered) — ESC to exit"

    if shutil.which("fzf"):
        fzf_cmd = [
            "fzf",
            "--ansi",
            f"--header={header}",
            "--prompt=🔍 Search binds > ",
            "--reverse",
            "--border=rounded",
            "--info=inline",
            "--no-preview",
            "--color=header:italic:bold:yellow,pointer:bright-cyan",
        ]
        p = subprocess.Popen(fzf_cmd, stdin=subprocess.PIPE, text=True)
        p.communicate(input="\n".join(lines) + "\n")
    else:
        print(header)
        print("-" * 70)
        for line in lines:
            print(line)

if __name__ == "__main__":
    main()
