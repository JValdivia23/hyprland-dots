#!/usr/bin/env bash
# ~/.local/bin/hypr-lid-handler
# Universal Clamshell Lid Event Handler for Hyprland

ACTION="${1:-toggle}"
KBD_STATE_FILE="/tmp/hypr_kbd_backlight_saved_${UID}"
PROFILE_STATE_FILE="/tmp/hypr_power_profile_saved_${UID}"

# Dynamically discover any system keyboard backlight device
KBD_DEV=$(ls /sys/class/leds/ 2>/dev/null | grep -E 'kbd_backlight|kbd' | head -n 1)

case "$ACTION" in
    close)
        # 1. Lock screen session
        noctalia msg session lock 2>/dev/null || loginctl lock-session 2>/dev/null || true

        # 2. Cut display power immediately via Wayland DPMS
        hyprctl dispatch dpms off 2>/dev/null || true

        # 3. Save active keyboard backlight level if present, then turn off
        if [ -n "$KBD_DEV" ] && [ -d "/sys/class/leds/$KBD_DEV" ]; then
            current_kbd=$(brightnessctl -d "$KBD_DEV" get 2>/dev/null || true)
            if [ -n "$current_kbd" ] && [ "$current_kbd" -gt 0 ]; then
                echo "$current_kbd" > "$KBD_STATE_FILE"
            fi
            brightnessctl -q -d "$KBD_DEV" set 0% 2>/dev/null || true
        fi

        # 4. Save active CPU profile and switch to power-saver mode
        if command -v powerprofilesctl >/dev/null 2>&1; then
            current_profile=$(powerprofilesctl get 2>/dev/null || echo "balanced")
            echo "$current_profile" > "$PROFILE_STATE_FILE"
            powerprofilesctl set power-saver 2>/dev/null || true
        fi

        # 5. Execute custom profile-specific lid hook if present
        if [ -x "$HOME/.config/hypr/hooks/lid-close" ]; then
            "$HOME/.config/hypr/hooks/lid-close" 2>/dev/null || true
        fi
        ;;

    open)
        # 1. Power display back on via Wayland DPMS
        hyprctl dispatch dpms on 2>/dev/null || true

        # 2. Restore keyboard backlight if previously saved
        if [ -n "$KBD_DEV" ] && [ -f "$KBD_STATE_FILE" ]; then
            saved_kbd=$(cat "$KBD_STATE_FILE" 2>/dev/null || true)
            if [ -n "$saved_kbd" ] && [ "$saved_kbd" -gt 0 ]; then
                brightnessctl -q -d "$KBD_DEV" set "$saved_kbd" 2>/dev/null || true
            fi
            rm -f "$KBD_STATE_FILE"
        fi

        # 3. Restore CPU power profile
        if command -v powerprofilesctl >/dev/null 2>&1; then
            if [ -f "$PROFILE_STATE_FILE" ]; then
                saved_prof=$(cat "$PROFILE_STATE_FILE" 2>/dev/null || true)
                if [ -n "$saved_prof" ]; then
                    powerprofilesctl set "$saved_prof" 2>/dev/null || true
                fi
                rm -f "$PROFILE_STATE_FILE"
            else
                powerprofilesctl set balanced 2>/dev/null || true
            fi
        fi

        # 4. Execute custom profile-specific lid hook if present
        if [ -x "$HOME/.config/hypr/hooks/lid-open" ]; then
            "$HOME/.config/hypr/hooks/lid-open" 2>/dev/null || true
        fi
        ;;

    *)
        echo "Usage: $0 {close|open}"
        exit 1
        ;;
esac
