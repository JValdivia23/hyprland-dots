#!/bin/bash

# Toggle to pop-out a tile to stay fixed/pinned on a display basis.
# Usage:
#   hypr-window-pop        -> Medium pop-out (1100x700, centered)
#   hypr-window-pop pip    -> Compact Video Picture-in-Picture (560x315, centered)

if [[ "$1" == "pip" ]]; then
  width=560
  height=315
else
  width=${1:-1100}
  height=${2:-700}
fi

active=$(hyprctl activewindow -j)
addr=$(echo "$active" | jq -r '.address // empty')
[ -z "$addr" ] && exit 0
pinned=$(echo "$active" | jq -r '.pinned')
floating=$(echo "$active" | jq -r '.floating')

lua_eval() {
  local out
  out=$(hyprctl eval "$1" 2>&1) || return 1
  [[ "$out" != error:* ]]
}

if [[ "$pinned" == "true" ]]; then
  # Window is pinned -> unpin it and unfloat back to tiled
  if ! lua_eval "hl.dispatch(hl.dsp.window.pin({ window = \"address:$addr\" })); hl.dispatch(hl.dsp.window.float({ action = \"toggle\", window = \"address:$addr\" }))"; then
    hyprctl dispatch pin
    hyprctl dispatch togglefloating
  fi
elif [[ "$floating" == "true" ]]; then
  # Already floating but not pinned -> just pin it
  if ! lua_eval "hl.dispatch(hl.dsp.window.pin({ window = \"address:$addr\" }))"; then
    hyprctl dispatch pin
  fi
else
  # Tiled window -> float, resize, center, pin, and bring to top
  if ! lua_eval "hl.dispatch(hl.dsp.window.float({ action = \"toggle\", window = \"address:$addr\" })); hl.dispatch(hl.dsp.window.resize({ x = ${width}, y = ${height}, relative = false, window = \"address:$addr\" })); hl.dispatch(hl.dsp.window.center({ window = \"address:$addr\" })); hl.dispatch(hl.dsp.window.pin({ window = \"address:$addr\" })); hl.dispatch(hl.dsp.window.alter_zorder({ mode = \"top\", window = \"address:$addr\" }))"; then
    hyprctl dispatch togglefloating
    hyprctl dispatch resizewindowpixel "exact ${width} ${height},activewindow"
    hyprctl dispatch centerwindow
    hyprctl dispatch pin
    hyprctl dispatch alterzorder top
  fi
fi
