[Unit]
Description=Hyprland Minimized Window Tray Drawer Daemon
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
Environment="PATH=%h/.local/bin:%h/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/usr/bin/python3 %h/.local/bin/hypr-tray-drawer daemon
Restart=always
RestartSec=1s

[Install]
WantedBy=graphical-session.target
