# Backups and temporary files
.dotfiles_backup_*
*.bak
*.old
*.swp
*~
*.log
# Compiled binaries & local installations
core/.local/bin/noctalia-precache-wallpapers
profiles/*/.local/bin/edgepad
**/.local/bin/edgepad

# Sensitive credentials and keys
*.key
*.pem
*.pub
id_rsa*
id_ed25519*

# Python & Node caches
__pycache__/
*.pyc
node_modules/
.venv/

# Large offline documentation git mirrors (if linked in agents)
references/cachyos-wiki/
references/noctalia-docs/
